<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <AssemblyName>CCToolbox</AssemblyName>
    <RootNamespace>WpfApp1</RootNamespace>
    <!-- 版本号唯一真源：发新版时只改这里，界面与更新检查在运行时读取程序集元数据。 -->
    <Version>2.3.8</Version>
    <AssemblyVersion>2.3.8.0</AssemblyVersion>
    <FileVersion>2.3.8.0</FileVersion>
    <InformationalVersion>2.3.8</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 将打包机器的本地日期写入程序集，运行时保持不变（含单文件 EXE）。 -->
    <AssemblyMetadata Include="ReleaseDate" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="favicon.ico" />
    <Resource Include="..\img\**\*.png" Exclude="..\img\ggw.png;..\img\空间查询.png;..\img\配图检查.png" Link="img\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="EPPlus" Version="8.5.1" />
    <PackageReference Include="ExcelDataReader" Version="3.8.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

</Project>
