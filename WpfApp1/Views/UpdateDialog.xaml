<Window x:Class="WpfApp1.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新"
        Width="470"
        MaxHeight="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        KeyDown="Window_KeyDown"
        FocusVisualStyle="{x:Null}">

    <Grid Margin="12">
        <Border CornerRadius="18" Background="#F5F8FC">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.18" Color="#14213D"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="18" Background="White" BorderBrush="#E5ECF5" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="18,16,18,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EEF5FF" Offset="0"/>
                            <GradientStop Color="#F8FAFC" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#2563EB" VerticalAlignment="Center">
                            <TextBlock Text="新" FontSize="16" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="检查更新" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="CC 实施工具箱 · 稳定通道" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="360" Margin="18,14,18,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtTitle" Text="发现新版本" FontSize="17" FontWeight="Bold" Foreground="#101A42"/>
                        <TextBlock x:Name="TxtSubTitle" Text="" FontSize="12" Foreground="#64748B" Margin="0,6,0,0"/>

                        <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="12"
                                Background="#F8FBFF" BorderBrush="#E8EEF7" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="更新内容" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="NotesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#243244"
                                                       TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="18"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,4" Padding="12,10" CornerRadius="12"
                                Background="#FFF8E8" BorderBrush="#F5E2B8" BorderThickness="1">
                            <TextBlock FontSize="11.5" Foreground="#7A5B12" TextWrapping="Wrap" LineHeight="18"
                                       Text="当前版本只做检查与提示：点击下方按钮会打开浏览器前往下载页面，需手动下载 CCToolbox.exe 并替换旧文件。替换前请先退出程序，随手记会在关闭窗口时自动保存。"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="0,12,0,0" Padding="18,10,18,14"
                        BorderBrush="#EEF2F7" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="按 Esc 稍后处理" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnSkip" Content="跳过此版本" Style="{DynamicResource ButtonSecondary}"
                                    FontSize="12" Padding="12,7" Margin="0,0,8,0" Click="BtnSkip_Click"/>
                            <Button x:Name="BtnLater" Content="稍后" Style="{DynamicResource ButtonSecondary}"
                                    FontSize="12" Padding="12,7" Margin="0,0,8,0" IsCancel="True" Click="BtnLater_Click"/>
                            <Button x:Name="BtnDownload" Content="前往下载" Style="{DynamicResource ButtonPrimary}"
                                    FontSize="12" Padding="16,7" IsDefault="True" Click="BtnDownload_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
